# LLM provider used by the Planner: "local" (Ollama, default) or "cloud" (Anthropic).
# "cloud" is an experimental comparison reference and must not be used in the air-gapped deployment.
LLM_PROVIDER=local

# --- local (Ollama) ---
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434

# --- cloud (Anthropic), optional: only needed when LLM_PROVIDER=cloud ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
