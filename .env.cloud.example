# Profile "cloud": the LLM is the Anthropic API. Experimental comparison reference
# ONLY; it sends finding data to an external service. Do not use with real
# infrastructure or sensitive data.
# Copy to .env (never commit .env).
DEPLOYMENT_PROFILE=cloud
LLM_PROVIDER=cloud

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# The local provider stays available under this profile (LLM_PROVIDER=local),
# e.g. to run both models on the same findings.
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434
